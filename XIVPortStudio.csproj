<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <PackageProjectUrl>https://github.com/link-0402/XIV-Port-Studio</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>XIVPortStudio</AssemblyName>
    <RootNamespace>XIVPortStudio</RootNamespace>
    <Configurations>Debug;Release</Configurations>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>DEBUG</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Exclude reference clones (e.g. TexTools/) from the SDK project globbing -->
    <DefaultItemExcludes>$(DefaultItemExcludes);TexTools/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="SharpGLTF.Toolkit" Version="1.0.5" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled shader material presets (sourced from TexTools) — see Services/MaterialPresetLibrary.cs -->
    <None Include="Resources\MaterialPresets\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Bundled placeholder textures — see Services/DummyTextureLibrary.cs -->
    <None Include="Resources\DummyTextures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
